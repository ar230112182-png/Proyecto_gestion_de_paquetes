  {
    "id": "hp_inject",
    "type": "inject",
    "z": "hp_tab",
    "name": "Simular huella ID 1",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "Found ID #1 with confidence of 150",
    "payloadType": "str",
    "x": 130,
    "y": 160,
    "wires": [
      [
        "hp_parse"
      ]
    ]
  },
  {
    "id": "hp_parse",
    "type": "function",
    "z": "hp_tab",
    "name": "Parsear 'Found ID #'",
    "func": "// Entrada: una línea del Arduino (ej: \"Found ID #3 with confidence of 150\")\nconst linea = String(msg.payload).trim();\nconst m = linea.match(/Found ID #(\\d+)(?: with confidence of (\\d+))?/);\n\nif (m) {\n    msg.huella_id = parseInt(m[1], 10);\n    msg.confianza = m[2] ? parseInt(m[2], 10) : null;\n    msg.topic = \"SELECT nombre_usuario FROM usuarios_h WHERE id_uh = :id\";\n    msg.payload = { id: msg.huella_id };\n    return [msg, null];\n}\nif (linea.includes(\"No match found\")) {\n    return [null, { payload: \"Huella no reconocida por el sensor\" }];\n}\nreturn [null, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 130,
    "wires": [
      [
        "hp_select"
      ],
      [
        "hp_dbg_nomatch"
      ]
    ]
  },
  {
    "id": "hp_dbg_nomatch",
    "type": "debug",
    "z": "hp_tab",
    "name": "Sin coincidencia",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 590,
    "y": 180,
    "wires": []
  },
  {
    "id": "hp_select",
    "type": "mysql",
    "z": "hp_tab",
    "mydb": "hp_db_cfg",
    "name": "Buscar usuario",
    "x": 580,
    "y": 120,
    "wires": [
      [
        "hp_eval"
      ]
    ]
  },
  {
    "id": "hp_eval",
    "type": "function",
    "z": "hp_tab",
    "name": "Evaluar acceso",
    "func": "// Entrada: resultado del SELECT en msg.payload\nconst rows = msg.payload;\nconst hora = new Date().toLocaleTimeString('es-MX', { hour12: false });\n\nif (Array.isArray(rows) && rows.length > 0) {\n    const nombre = rows[0].nombre_usuario;\n    flow.set('ultimo', { nombre: nombre, id: msg.huella_id, fecha: hora, estado: 'concedido' });\n    node.status({ fill: \"green\", shape: \"dot\", text: \"Acceso: \" + nombre });\n\n    const insertar = {\n        huella_id: msg.huella_id,\n        topic: \"INSERT INTO logs_acceso (usuario_id, fecha) VALUES (:id, NOW())\",\n        payload: { id: msg.huella_id }\n    };\n    return [insertar, { payload: \"Acceso concedido a: \" + nombre }];\n}\n\nflow.set('ultimo', { nombre: 'Desconocido', id: msg.huella_id, fecha: hora, estado: 'denegado' });\nnode.status({ fill: \"red\", shape: \"ring\", text: \"ID \" + msg.huella_id + \" no encontrado\" });\nreturn [null, { payload: \"ID #\" + msg.huella_id + \" no encontrado.\" }];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 120,
    "wires": [
      [
        "hp_insert"
      ],
      [
        "hp_dbg_acceso"
      ]
    ]
  },
