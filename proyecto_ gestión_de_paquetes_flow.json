    "wires": [
      [
        "hp_webfn"
      ]
    ]
  },
  {
    "id": "hp_webfn",
    "type": "function",
    "z": "hp_tab",
    "name": "Preparar consulta",
    "func": "// Prepara la consulta del historial y recupera el último acceso\nlet ultimo = flow.get('ultimo');\nif (!ultimo) {\n    ultimo = { nombre: 'Esperando...', id: '-', fecha: '-', estado: 'espera' };\n    flow.set('ultimo', ultimo);\n}\nmsg.ultimo = ultimo;\nmsg.topic = \"SELECT u.nombre_usuario, l.usuario_id, \" +\n            \"DATE_FORMAT(l.fecha, '%Y-%m-%d %H:%i:%s') AS fecha \" +\n            \"FROM logs_acceso l LEFT JOIN usuarios_h u ON u.id_uh = l.usuario_id \" +\n            \"ORDER BY l.fecha DESC LIMIT 10\";\nmsg.payload = {};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 340,
    "wires": [
      [
        "hp_hist"
      ]
    ]
  },
  {
    "id": "hp_hist",
    "type": "mysql",
    "z": "hp_tab",
    "mydb": "hp_db_cfg",
    "name": "Últimos logs",
    "x": 530,
    "y": 340,
    "wires": [
      [
        "hp_tpl"
      ]
    ]
  },
  {
    "id": "hp_tpl",
    "type": "template",
    "z": "hp_tab",
    "name": "HTML",
    "field": "payload",
    "fieldType": "msg",
    "format": "handlebars",
    "syntax": "mustache",
    "template": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta http-equiv=\"refresh\" content=\"2\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Control de acceso por huella</title>\n<style>\n  body { font-family: system-ui, sans-serif; background:#f3f4f6; margin:0; padding:24px; color:#111827; }\n  h1 { font-size:1.4rem; }\n  .card { max-width:480px; padding:20px; border-radius:12px; background:#fff; border-left:8px solid #9ca3af; box-shadow:0 1px 4px rgba(0,0,0,.1); }\n  .card.concedido { border-color:#16a34a; }\n  .card.denegado { border-color:#dc2626; }\n  .label { font-size:.8rem; text-transform:uppercase; color:#6b7280; }\n  .nombre { font-size:2rem; font-weight:700; margin:6px 0; }\n  table { margin-top:12px; border-collapse:collapse; background:#fff; width:100%; max-width:480px; }\n  th, td { padding:8px 12px; text-align:left; border-bottom:1px solid #e5e7eb; }\n  th { background:#e5e7eb; }\n</style>\n</head>\n<body>\n  <h1>Control de acceso por huella</h1>\n  <div class=\"card {{ultimo.estado}}\">\n    <div class=\"label\">Último acceso</div>\n    <div class=\"nombre\">{{ultimo.nombre}}</div>\n    <div>ID: {{ultimo.id}} &middot; Hora: {{ultimo.fecha}}</div>\n  </div>\n  <h2>Últimos 10 registros</h2>\n  <table>\n    <tr><th>Usuario</th><th>ID</th><th>Fecha</th></tr>\n    {{#payload}}\n    <tr><td>{{nombre_usuario}}</td><td>{{usuario_id}}</td><td>{{fecha}}</td></tr>\n    {{/payload}}\n  </table>\n</body>\n</html>",
    "output": "str",
    "x": 710,
    "y": 340,
    "wires": [
      [
        "hp_http_out"
      ]
    ]
  },
